#!/usr/bin/env bash
set -euo pipefail

step() {
	printf '\n==> %s\n' "$1"
}

step 'Ensure Node.js 26'
node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if (( node_major < 26 )); then
  node_version="$(curl -sSf https://nodejs.org/dist/index.json | jq -r '[.[] | select(.version | startswith("v26"))][0].version')"
  mkdir -p "$HOME/.local/node26"
  curl -sSf "https://nodejs.org/dist/${node_version}/node-${node_version}-linux-x64.tar.xz" |
    tar -xJ -C "$HOME/.local/node26" --strip-components=1
  export PATH="$HOME/.local/node26/bin:$PATH"
fi
node --version

step 'Ensure Rust toolchain'
if ! command -v cargo >/dev/null 2>&1 && [[ ! -x "$HOME/.cargo/bin/cargo" ]]; then
  curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none
fi
export PATH="$HOME/.cargo/bin:$PATH"
(cd packages/irodori && cargo --version)

step 'Ensure pnpm 12.0.0'
current_pnpm="$(pnpm --version 2>/dev/null || true)"
if [[ "$current_pnpm" != '12.0.0' ]]; then
  npm install --global pnpm@12.0.0
fi
pnpm --version

step 'Install workspace dependencies'
pnpm install --frozen-lockfile

step 'Patch oxlint to use the Effect rules'
pnpm exec effect-tsrs patch --oxlint
